<% layout('layout') -%>
<div class="page-head"><h1>Users</h1>
  <a class="btn btn-gold" href="/users/new">+ New User</a>
</div>
<p class="hint">Internal accounts. Only an admin can create or disable users. Agent / client accounts are scoped to their linked record.</p>
<% if (!users.length) { %><%- include('../partials/empty', { msg: 'No users yet.' }) %><% } else { %>
<table class="data">
  <thead><tr><th>Username</th><th>Full Name</th><th>Role</th><th>Linked to</th><th>Status</th><th>Action</th></tr></thead>
  <tbody>
  <% users.forEach(u => { %>
    <tr>
      <td class="mono"><%= u.username %></td>
      <td><%= u.full_name %></td>
      <td><span class="badge <%= u.role==='admin'?'is-red':u.role==='manager'?'is-blue':u.role==='auditor'?'is-gold':'is-neutral' %>"><%= u.role %></span></td>
      <td><%= u.agent_name || u.client_name || '—' %></td>
      <td><% if (u.active) { %><span class="badge is-green">active</span><% } else { %><span class="badge is-neutral">disabled</span><% } %></td>
      <td>
        <div style="display:flex; gap:0.5rem; align-items:center;">
          <a class="btn btn-sm" href="/users/<%= u.id %>/edit" title="Edit"><%- h.icon('edit') %></a>
          <a class="btn btn-sm" href="/users/<%= u.id %>/password">Reset PW</a>
          <% if (u.id !== currentUser.id) { %>
          <form method="post" action="/users/<%= u.id %>/toggle" style="margin:0;">
            <button class="btn btn-sm" type="submit"><%= u.active ? 'Disable' : 'Enable' %></button>
          </form>
          <% } %>
        </div>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
<% } %>
