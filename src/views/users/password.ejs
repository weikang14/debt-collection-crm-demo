<% layout('layout') -%>
<div class="page-head"><h1>Reset Password</h1></div>
<form class="card form" method="post" action="/users/<%= u.id %>/password">
  <p>Set a new password for <strong><%= u.full_name %></strong> (<span class="mono"><%= u.username %></span>). The user will sign in with this new password immediately.</p>
  <label>New Password <input name="password" type="password" required minlength="8" autocomplete="new-password" autofocus></label>
  <div class="form-actions"><button class="btn btn-gold" type="submit">Update Password</button><a class="btn" href="/users">Cancel</a></div>
</form>
