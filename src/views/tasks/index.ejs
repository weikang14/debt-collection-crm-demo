<% layout('layout') -%>
<div class="page-head"><h1>Tasks</h1>
</div>
<form class="card filters" method="get" action="/tasks">
  <label>Status <select name="status">
    <option value="" <%= !query.status?'selected':'' %>>All</option>
    <option value="pending" <%= query.status==='pending'?'selected':'' %>>Pending</option>
    <option value="done" <%= query.status==='done'?'selected':'' %>>Done</option>
  </select></label>
  <label>Type <select name="type">
    <option value="" <%= !query.type?'selected':'' %>>All</option>
    <% ['follow_up','visit','legal','reminder'].forEach(tp => { %><option value="<%= tp %>" <%= query.type===tp?'selected':'' %>><%= tp %></option><% }) %>
  </select></label>
  <label>Overdue only <input type="checkbox" name="overdue" value="1" <%= query.overdue==='1'?'checked':'' %>></label>
  <button class="btn btn-gold" type="submit">Filter</button>
</form>
<% if (['admin','manager','agent'].includes(currentUser.role)) { %>
<details class="new-panel">
  <summary class="btn btn-gold">+ New Task</summary>
  <form class="card form" method="post" action="/tasks/new">
    <label>Case <select name="case_id">
      <option value="">—</option>
      <% cases.forEach(c => { %><option value="<%= c.id %>"><%= c.case_no %></option><% }) %>
    </select></label>
    <label>Agent <select name="agent_id">
      <option value="">—</option>
      <% agents.forEach(a => { %><option value="<%= a.id %>"><%= a.name %></option><% }) %>
    </select></label>
    <label>Type <select name="type">
      <option value="follow_up">follow_up</option>
      <option value="visit">visit</option>
      <option value="legal">legal</option>
      <option value="reminder">reminder</option>
    </select></label>
    <label>Title <input type="text" name="title" required></label>
    <label>Due Date <input type="date" name="due_date"></label>
    <label>Notes <input type="text" name="notes"></label>
    <div class="form-actions"><button class="btn btn-gold" type="submit">Save</button></div>
  </form>
</details>
<% } %>
<% if (!tasks.length) { %><%- include('../partials/empty', { msg: 'No tasks yet.' }) %><% } else { %>
<table class="data"><thead><tr><th>Title</th><th>Case No</th><th>Type</th><th>Due</th><th>Status</th><th>Actions</th></tr></thead>
<tbody><% tasks.forEach(t => { %>
<tr>
  <td><%= t.title %></td>
  <td><% if (t.case_id) { %><a class="mono" href="/cases/<%= t.case_id %>"><%= t.case_no %></a><% } else { %>—<% } %></td>
  <td><%= t.type %></td>
  <td><% if (t.status==='pending' && t.due_date && h.daysOverdue(t.due_date) > 0) { %><span class="badge is-red"><%= h.dateFmt(t.due_date) %> · overdue</span><% } else if (t.due_date) { %><%= h.dateFmt(t.due_date) %><% } else { %>—<% } %></td>
  <td><span class="badge <%= t.status==='done'?'is-green':'is-gold' %>"><%= t.status %></span></td>
  <td>
    <% if (['admin','manager','agent'].includes(currentUser.role)) { %>
    <div class="row-actions">
      <button type="button" class="btn btn-sm" onclick="editTask(this)"
        data-id="<%= t.id %>" data-title="<%= t.title %>" data-type="<%= t.type %>"
        data-due="<%= t.due_date || '' %>" data-notes="<%= t.notes || '' %>">Edit</button>
      <% if (t.status==='pending') { %><form class="inline-form" method="post" action="/tasks/<%= t.id %>/complete"><button class="btn btn-sm" type="submit">Complete</button></form><% } %>
    </div>
    <% } else { %>—<% } %>
  </td>
</tr>
<% }) %></tbody></table><% } %>
<% if (['admin','manager','agent'].includes(currentUser.role)) { %>
<dialog id="dlg-task-edit" class="modal"><form class="form" id="task-edit-form" method="post" action="">
  <h3>Edit Task</h3>
  <label>Title <input type="text" name="title" id="te-title" required></label>
  <label>Type <select name="type" id="te-type">
    <% ['follow_up','visit','legal','reminder'].forEach(tp => { %><option value="<%= tp %>"><%= tp %></option><% }) %>
  </select></label>
  <label>Due Date <input type="date" name="due_date" id="te-due"></label>
  <label>Notes <input type="text" name="notes" id="te-notes"></label>
  <div class="form-actions"><button class="btn btn-gold" type="submit">Save</button><button class="btn" type="button" onclick="this.closest('dialog').close()">Cancel</button></div>
</form></dialog>
<script>
  function editTask(btn){
    var f = document.getElementById('task-edit-form');
    f.action = '/tasks/' + btn.dataset.id;
    document.getElementById('te-title').value = btn.dataset.title;
    document.getElementById('te-type').value = btn.dataset.type;
    document.getElementById('te-due').value = btn.dataset.due;
    document.getElementById('te-notes').value = btn.dataset.notes;
    document.getElementById('dlg-task-edit').showModal();
  }
  document.querySelectorAll('dialog.modal').forEach(function(d){
    d.addEventListener('click', function(e){ if (e.target === d) d.close(); });
  });
</script>
<% } %>
