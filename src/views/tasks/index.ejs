<% layout('layout') -%>
<div class="page-head"><h1>Tasks</h1>
  <% if (['admin','manager','agent'].includes(currentUser.role)) { %><a class="btn btn-gold" href="/tasks/new">+ New Task</a><% } %>
</div>
<% if (['admin','manager','agent'].includes(currentUser.role)) { %>
<form class="card form" method="post" action="/tasks/new">
  <label>Case <select name="case_id">
    <option value="">—</option>
    <% cases.forEach(c => { %><option value="<%= c.id %>"><%= c.case_no %></option><% }) %>
  </select></label>
  <label>Agent <select name="agent_id">
    <option value="">—</option>
    <% agents.forEach(a => { %><option value="<%= a.id %>"><%= a.name %></option><% }) %>
  </select></label>
  <label>Type <select name="type">
    <option value="follow_up">follow_up</option>
    <option value="visit">visit</option>
    <option value="legal">legal</option>
    <option value="reminder">reminder</option>
  </select></label>
  <label>Title <input type="text" name="title" required></label>
  <label>Due Date <input type="date" name="due_date"></label>
  <label>Notes <input type="text" name="notes"></label>
  <div class="form-actions"><button class="btn btn-gold" type="submit">Save</button></div>
</form>
<% } %>
<% if (!tasks.length) { %><%- include('../partials/empty', { msg: 'No tasks yet.' }) %><% } else { %>
<table class="data"><thead><tr><th>Title</th><th>Case No</th><th>Type</th><th>Due</th><th>Status</th><th>Actions</th></tr></thead>
<tbody><% tasks.forEach(t => { %>
<tr>
  <td><%= t.title %></td>
  <td><% if (t.case_id) { %><a class="mono" href="/cases/<%= t.case_id %>"><%= t.case_no %></a><% } else { %>—<% } %></td>
  <td><%= t.type %></td>
  <td><% if (t.status==='pending' && t.due_date && h.daysOverdue(t.due_date) > 0) { %><span class="badge is-red"><%= h.dateFmt(t.due_date) %> · overdue</span><% } else if (t.due_date) { %><%= h.dateFmt(t.due_date) %><% } else { %>—<% } %></td>
  <td><span class="badge <%= t.status==='done'?'is-green':'is-gold' %>"><%= t.status %></span></td>
  <td><% if (t.status==='pending' && ['admin','manager','agent'].includes(currentUser.role)) { %><form class="inline-form" method="post" action="/tasks/<%= t.id %>/complete"><button class="btn" type="submit">Complete</button></form><% } else { %>—<% } %></td>
</tr>
<% }) %></tbody></table><% } %>
