<!doctype html><html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' — ' : typeof message !== 'undefined' ? 'Error — ' : '' %>Debt Collection CRM</title>
<link rel="stylesheet" href="/css/style.css">
</head><body class="app">
  <header class="mobile-topbar">
    <button class="nav-toggle" type="button" aria-label="Menu" onclick="document.body.classList.toggle('nav-open')">&#9776;</button>
    <span class="brand">Debt Collection <span>CRM</span></span>
  </header>
  <%- include('partials/sidebar') %>
  <div class="nav-backdrop" onclick="document.body.classList.remove('nav-open')"></div>
  <main class="content">
    <% if (typeof demoBanner !== 'undefined' && demoBanner) { %><div class="alert is-red">Demo environment — use made-up data only. Do not enter real personal or loan details; data is reset on every restart.</div><% } %>
    <%- include('partials/flash') %>
    <%- body %>
  </main>
<script>
  // G-21: a second click on a submit button doesn't post the form again.
  document.addEventListener('submit', function (e) {
    if (e.defaultPrevented) return;
    var b = e.submitter || e.target.querySelector('button[type=submit]');
    if (b) setTimeout(function () { b.disabled = true; }, 0);
  });
</script>
</body></html>
