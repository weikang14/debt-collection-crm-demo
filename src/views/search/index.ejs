<% layout('layout') -%>
<div class="page-head"><h1>Search</h1></div>
<form class="card filters" method="get" action="/search">
  <label>Query <input type="search" name="q" value="<%= q %>" placeholder="Case no, debtor name, IC, or phone"></label>
  <button class="btn btn-gold" type="submit">Search</button>
</form>
<% if (!q) { %>
  <%- include('../partials/empty', { msg: 'Enter a search term above.' }) %>
<% } else if (!results.length) { %>
  <%- include('../partials/empty', { msg: 'No matches for "' + q + '".' }) %>
<% } else { %>
  <div class="card">
    <p><strong><%= results.length %></strong> result<%= results.length === 1 ? '' : 's' %> found.</p>
    <table class="data"><thead><tr><th>Case No</th><th>Debtor</th><th>IC</th><th>Phone</th><th>Status</th></tr></thead>
    <tbody><% results.forEach(r => { %>
    <tr><td><a class="mono" href="/cases/<%= r.id %>"><%= r.case_no %></a></td><td><%= r.debtor_name %></td><td class="mono"><%= r.ic_passport || '—' %></td><td class="mono"><%= r.debtor_phone || '—' %></td><td><%- include('../partials/statusBadge', { status: r.status }) %></td></tr>
    <% }) %></tbody></table>
  </div>
<% } %>
