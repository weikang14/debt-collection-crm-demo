<% layout('layout') -%>
<% const isAccess = typeof access !== 'undefined' && access; %>
<div class="page-head"><h1>Audit Log</h1>
  <div style="display:flex; gap:0.5rem;">
    <a class="btn<%= isAccess ? '' : ' btn-gold' %>" href="/audit-log">Changes</a>
    <a class="btn<%= isAccess ? ' btn-gold' : '' %>" href="/audit-log?log=access" title="Who viewed, searched or printed personal data">Access log</a>
  </div>
</div>

<form class="filters" method="get" action="/audit-log">
  <% if (isAccess) { %><input type="hidden" name="log" value="access"><% } %>
  <label>Action
    <select name="action">
      <option value="">All actions</option>
      <% actions.forEach(a => { %>
      <option value="<%= a.action %>" <%= query.action===a.action?'selected':'' %>><%= a.action %></option>
      <% }) %>
    </select>
  </label>
  <label>Entity
    <select name="entity">
      <option value="">All entities</option>
      <% entities.forEach(e => { %>
      <option value="<%= e.entity_type %>" <%= query.entity===e.entity_type?'selected':'' %>><%= e.entity_type %></option>
      <% }) %>
    </select>
  </label>
  <label>From <input type="date" name="from" value="<%= query.from||'' %>"></label>
  <label>To <input type="date" name="to" value="<%= query.to||'' %>"></label>
  <button class="btn btn-gold" type="submit">Apply</button>
  <a class="btn" href="/audit-log?<%= new URLSearchParams({ ...(isAccess ? { log: 'access' } : {}), action: query.action||'', entity: query.entity||'', from: query.from||'', to: query.to||'', format: 'csv' }) %>">Export CSV</a>
</form>
<p class="hint">Showing the latest 200 matching entries. Narrow by date, or export CSV for the full list.</p>

<% if (logs.length===0) { %>
<%- include('../partials/empty', { msg: 'No audit entries.' }) %>
<% } else { %>
<table class="data">
  <thead>
    <tr>
      <th>Time</th>
      <th>User</th>
      <th>Action</th>
      <th>Entity</th>
      <th>Details</th>
      <th>IP</th>
    </tr>
  </thead>
  <tbody>
  <% logs.forEach(l => { %>
    <tr>
      <td><%= h.dateTimeFmt(l.created_at) %></td>
      <td><%= l.username||'—' %></td>
      <td><span class="badge"><%= l.action %></span></td>
      <td><%= l.entity_type %><% if (l.entity_id) { %>#<%= l.entity_id %><% } %></td>
      <td><%= l.details||'' %></td>
      <td class="mono"><%= l.ip_address||'—' %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
<% } %>
