<% layout('layout') -%>
<div class="page-head">
  <h1>Dashboard</h1>
  <span class="meta">Welcome, <%= currentUser.full_name %></span>
</div>

<div class="qrow">
  <div class="q hot">
    <div class="lbl2">Collected Today</div>
    <div class="v2">RM <%= h.money(kpi.collectedToday) %></div>
    <div class="sub2"><%= kpi.paymentsToday %> payment<%= kpi.paymentsToday === 1 ? '' : 's' %> today</div>
  </div>
  <div class="q"><div class="lbl2">Total Outstanding</div><div class="v2">RM <%= h.money(kpi.outstanding) %></div></div>
  <div class="q"><div class="lbl2">Active / Legal</div><div class="v2"><%= kpi.activeCases %> / <%= kpi.legalCount %></div></div>
  <div class="q"><div class="lbl2">PTP Due / Overdue / Broken</div><div class="v2"><%= kpi.ptpToday %> / <%= kpi.overduePtp %> / <%= kpi.brokenPtp %></div></div>
</div>

<div class="chiprow">
  <span class="grp">Cases</span>
  <span class="chip<%= kpi.openedToday ? ' is-green' : '' %>"><span class="dot"></span>Opened today <b><%= kpi.openedToday %></b></span>
  <span class="chip"><span class="dot"></span>Closed today <b><%= kpi.closedToday %></b></span>
  <span class="chip<%= kpi.overdueTasks ? ' is-gold' : '' %>"><span class="dot"></span>Overdue tasks <b><%= kpi.overdueTasks %></b></span>
  <span class="chip<%= kpi.followupCount ? ' is-gold' : '' %>"><span class="dot"></span>Upcoming (14d) <b><%= kpi.followupCount %></b></span>
</div>

<h2>Aging <span class="meta">outstanding by debt age (days)</span></h2>
<% const maxAge = Math.max(...aging, 1); %>
<div class="panel">
  <div class="agelines">
    <% agingLabels.forEach((lbl, i) => { %>
    <div class="al"><span><%= lbl %>d</span><span class="tr"><i style="width:<%= Math.round(aging[i] / maxAge * 100) %>%"></i></span><span class="v">RM <%= h.money(aging[i]) %></span></div>
    <% }) %>
  </div>
</div>

<div class="dash-two">
  <div>
    <h2>Upcoming Follow-ups <span class="meta">next 14 days</span></h2>
    <% if (!followups.length) { %><%- include('../partials/empty', { msg: 'Nothing due for follow-up.' }) %><% } else { %>
    <div class="panel flush">
      <table class="data"><thead><tr><th>Case No</th><th>Debtor</th><th>Agent</th><th>Task</th><th class="num">Outstanding</th></tr></thead>
      <tbody>
      <% followups.forEach(f => { const b = h.followupBadge(f.days_over); %>
      <tr><td><a href="/cases/<%= f.case_id %>"><%= f.case_no %></a></td><td><%= f.debtor_name %></td>
      <td><%= f.agent_name || '—' %></td>
      <td><span class="badge <%= b.cls %>"><%= b.label %></span> <%= f.title %></td>
      <td class="num"><%= h.money(f.outstanding_amount) %></td></tr>
      <% }) %>
      </tbody></table>
    </div>
    <% } %>

    <% if (leaderboard) { %>
    <h2>Agent Leaderboard</h2>
    <% if (!leaderboard.length) { %><%- include('../partials/empty', { msg: 'No agents yet.' }) %><% } else { %>
    <div class="panel flush plainlist">
      <% leaderboard.forEach(row => { %>
      <div class="row"><span><%= row.name %></span><span class="num">RM <%= h.money(row.collected) %></span></div>
      <% }) %>
    </div>
    <% } %>
    <% } %>
  </div>

  <div>
    <h2>Recent Activity</h2>
    <% if (!recent.length) { %><%- include('../partials/empty', { msg: 'No activity yet.' }) %><% } else { %>
    <% const tick = { payment: 'g', ptp_fulfilled: 'g', ptp_broken: 'r', ptp_created: 'y', status_change: 'b', legal: 'r', call: 'b' }; %>
    <div class="panel flush">
      <ul class="feed">
      <% recent.forEach(ev => { %>
      <li><span class="tk <%= tick[ev.event_type] || '' %>"></span><div><%= ev.content %>
      <span class="m"><% if (ev.case_id) { %><a href="/cases/<%= ev.case_id %>"><%= ev.case_no %></a><% } else { %><%= ev.case_no %><% } %> · <%= ev.created_by || 'system' %> · <%= h.dateTimeFmt(ev.created_at) %></span></div></li>
      <% }) %>
      </ul>
    </div>
    <% } %>
  </div>
</div>
