<% layout('layout') -%>
<div class="page-head">
  <h1>Dashboard</h1>
  <span class="meta">Welcome, <%= currentUser.full_name %></span>
</div>

<div class="ledger dash-ledger">
  <div>
    <div class="ledger-lbl">Collected Today</div>
    <div class="ledger-amt pos"><span class="ledger-cur">RM</span><%= h.money(kpi.collectedToday) %></div>
    <div class="ledger-meta"><%= kpi.paymentsToday %> payment<%= kpi.paymentsToday === 1 ? '' : 's' %> today</div>
  </div>
  <div class="ledger-vr"></div>
  <div class="ledger-break">
    <div><span class="ledger-lbl">Total Outstanding</span><div class="ledger-val">RM <%= h.money(kpi.outstanding) %></div></div>
    <div><span class="ledger-lbl">Active Cases</span><div class="ledger-val"><%= kpi.activeCases %></div></div>
    <div><span class="ledger-lbl">Legal Cases</span><div class="ledger-val"><%= kpi.legalCount %></div></div>
  </div>
</div>

<div class="chiprow">
  <span class="grp">PTP</span>
  <span class="chip<%= kpi.ptpToday ? ' is-gold' : '' %>"><span class="dot"></span>Due today <b><%= kpi.ptpToday %></b></span>
  <span class="chip<%= kpi.overduePtp ? ' is-red' : '' %>"><span class="dot"></span>Overdue <b><%= kpi.overduePtp %></b></span>
  <span class="chip<%= kpi.brokenPtp ? ' is-red' : '' %>"><span class="dot"></span>Broken <b><%= kpi.brokenPtp %></b></span>
  <span class="vsep"></span>
  <span class="grp">Cases</span>
  <span class="chip<%= kpi.openedToday ? ' is-green' : '' %>"><span class="dot"></span>Opened today <b><%= kpi.openedToday %></b></span>
  <span class="chip"><span class="dot"></span>Closed today <b><%= kpi.closedToday %></b></span>
  <span class="chip<%= kpi.overdueTasks ? ' is-gold' : '' %>"><span class="dot"></span>Overdue tasks <b><%= kpi.overdueTasks %></b></span>
</div>

<h2>Aging <span class="meta">outstanding by debt age (days)</span></h2>
<% const AG = ['#f2dcb3', '#cf9a4c', '#b7842a', '#653f16']; %>
<div class="panel">
  <% if (aging.some(a => a > 0)) { %>
  <div class="stackbar">
    <% aging.forEach((amt, i) => { if (amt > 0) { %><i style="flex:<%= amt %>;background:<%= AG[i] %>"></i><% } }) %>
  </div>
  <% } %>
  <div class="aleg">
    <% agingLabels.forEach((lbl, i) => { %>
    <span class="it"><span class="sw" style="background:<%= AG[i] %>"></span><%= lbl %> d <span class="v">RM <%= h.money(aging[i]) %></span></span>
    <% }) %>
  </div>
</div>

<div class="dash-two">
  <div>
    <h2>Due for Follow-up</h2>
    <% if (!followups.length) { %><%- include('../partials/empty', { msg: 'Nothing due for follow-up.' }) %><% } else { %>
    <div class="panel flush">
      <table class="data"><thead><tr><th>Case No</th><th>Debtor</th><th>Status</th><th class="num">Outstanding</th></tr></thead>
      <tbody>
      <% followups.forEach(f => { %>
      <tr><td><a href="/cases/<%= f.id %>"><%= f.case_no %></a></td><td><%= f.debtor_name %></td>
      <td><% if (f.days_over > 0) { %><span class="badge is-red"><%= f.days_over %>d late</span><% } else { %><span class="badge is-gold">Today</span><% } %></td>
      <td class="num"><%= h.money(f.outstanding_amount) %></td></tr>
      <% }) %>
      </tbody></table>
    </div>
    <% } %>

    <% if (leaderboard) { %>
    <h2>Agent Leaderboard</h2>
    <% if (!leaderboard.length) { %><%- include('../partials/empty', { msg: 'No agents yet.' }) %><% } else { %>
    <% const max = leaderboard.length ? leaderboard[0].collected : 0; %>
    <div class="panel flush">
      <table class="data"><thead><tr><th>Agent</th><th class="num">Collected</th><th>Attainment</th></tr></thead>
      <tbody>
      <% leaderboard.forEach(row => { const pct = max > 0 ? Math.round(row.collected / max * 100) : 0; %>
      <tr><td><%= row.name %></td><td class="num"><%= h.money(row.collected) %></td>
      <td><div class="bar"><div class="fill is-green" style="width: <%= pct %>%"></div></div></td></tr>
      <% }) %>
      </tbody></table>
    </div>
    <% } %>
    <% } %>
  </div>

  <div>
    <h2>Recent Activity</h2>
    <% if (!recent.length) { %><%- include('../partials/empty', { msg: 'No activity yet.' }) %><% } else { %>
    <% const tick = { payment: 'g', ptp_fulfilled: 'g', ptp_broken: 'r', ptp_created: 'y', status_change: 'b', legal: 'r', call: 'b' }; %>
    <div class="panel flush">
      <ul class="feed">
      <% recent.forEach(ev => { %>
      <li><span class="tk <%= tick[ev.event_type] || '' %>"></span><div><%= ev.content %>
      <span class="m"><% if (ev.case_id) { %><a href="/cases/<%= ev.case_id %>"><%= ev.case_no %></a><% } else { %><%= ev.case_no %><% } %> · <%= ev.created_by || 'system' %> · <%= h.dateTimeFmt(ev.created_at) %></span></div></li>
      <% }) %>
      </ul>
    </div>
    <% } %>
  </div>
</div>
