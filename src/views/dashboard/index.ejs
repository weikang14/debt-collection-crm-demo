<% layout('layout') -%>
<div class="page-head">
  <h1>Dashboard</h1>
  <span>Welcome, <%= currentUser.full_name %></span>
</div>

<div class="kpi">
  <div class="tile"><div class="label">Collected Today</div><div class="value">RM <%= h.money(kpi.collectedToday) %></div></div>
  <div class="tile"><div class="label">Total Outstanding</div><div class="value">RM <%= h.money(kpi.outstanding) %></div></div>
  <div class="tile"><div class="label">PTP Due Today</div><div class="value"><%= kpi.ptpToday %></div></div>
  <div class="tile"><div class="label">Broken PTP</div><div class="value"><%= kpi.brokenPtp %></div></div>
  <div class="tile"><div class="label">Overdue PTP</div><div class="value"><%= kpi.overduePtp %></div></div>
  <div class="tile"><div class="label">Legal Cases</div><div class="value"><%= kpi.legalCount %></div></div>
  <div class="tile"><div class="label">Opened Today</div><div class="value"><%= kpi.openedToday %></div></div>
  <div class="tile"><div class="label">Closed Today</div><div class="value"><%= kpi.closedToday %></div></div>
  <div class="tile"><div class="label">Overdue Tasks</div><div class="value"><%= kpi.overdueTasks %></div></div>
</div>

<h2>Aging <span class="meta">outstanding by debt age (days)</span></h2>
<div class="kpi">
  <% agingLabels.forEach((lbl, i) => { %>
  <div class="tile"><div class="label"><%= lbl %> days</div><div class="value">RM <%= h.money(aging[i]) %></div></div>
  <% }) %>
</div>

<h2>Due for Follow-up</h2>
<% if (!followups.length) { %><%- include('../partials/empty', { msg: 'Nothing due for follow-up.' }) %><% } else { %>
<table class="data"><thead><tr><th>Case No</th><th>Debtor</th><th>Next Action</th></tr></thead>
<tbody>
<% followups.forEach(f => { %><tr><td><a href="/cases/<%= f.id %>"><%= f.case_no %></a></td><td><%= f.debtor_name %></td><td><%= h.dateFmt(f.next_action_at) %></td></tr><% }) %>
</tbody></table>
<% } %>

<% if (leaderboard) { %>
<h2>Agent Leaderboard</h2>
<% if (!leaderboard.length) { %><%- include('../partials/empty', { msg: 'No agents yet.' }) %><% } else { %>
<% const max = leaderboard.length ? leaderboard[0].collected : 0; %>
<table class="data"><thead><tr><th>Agent</th><th class="num">Collected</th><th>Attainment</th></tr></thead>
<tbody>
<% leaderboard.forEach(row => { const pct = max > 0 ? Math.round(row.collected / max * 100) : 0; %>
<tr><td><%= row.name %></td><td class="num"><%= h.money(row.collected) %></td>
<td><div class="bar"><div class="fill is-green" style="width: <%= pct %>%"></div></div></td></tr>
<% }) %>
</tbody></table>
<% } %>
<% } %>

<h2>Recent Activity</h2>
<% if (!recent.length) { %><%- include('../partials/empty', { msg: 'No activity yet.' }) %><% } else { %>
<% const evClass = { payment:'is-green', ptp_fulfilled:'is-green', ptp_broken:'is-red', ptp_created:'is-gold', status_change:'is-blue', legal:'is-red', call:'is-blue' }; %>
<ul class="timeline">
<% recent.forEach(ev => { %><li><span class="badge <%= evClass[ev.event_type]||'is-neutral' %>"><%= ev.event_type %></span> <%= ev.content %>
<span class="meta"><% if (ev.case_id) { %><a href="/cases/<%= ev.case_id %>"><%= ev.case_no %></a><% } else { %><%= ev.case_no %><% } %> · <%= ev.created_by||'system' %> · <%= h.dateTimeFmt(ev.created_at) %></span></li><% }) %>
</ul>
<% } %>
