<% layout('layout'); -%>
<% const may = typeof can === 'function' ? can : () => true; %>
<div class="page-head"><h1><%= debtor.name %></h1>
  <% if (may('debtors.edit') && !debtor.anonymized_at) { %><a class="btn" href="/debtors/<%= debtor.id %>/edit">Edit</a><% } %>
</div>
<% if (debtor.anonymized_at) { %><p class="hint">Personal data removed on <%= h.dateFmt(debtor.anonymized_at) %> after the retention period (F-35).</p><% } %>
<% (typeof previous !== 'undefined' ? previous : []).forEach(p => { %><div class="alert is-gold">Previously on file: this IC/Passport belonged to <a href="/debtors/<%= p.id %>">debtor #<%= p.id %></a>, whose personal data was removed on <%= p.removed %> after the retention period.</div><% }) %>
<div class="card kv">
  <div><span>IC/Passport</span><span class="mono"><%= debtor.ic_passport||'—' %></span></div><div><span>Company</span><%= debtor.company||'—' %></div>
  <div><span>Phone</span><span class="mono"><%= debtor.phone||'—' %></span></div><div><span>Email</span><%= debtor.email||'—' %></div>
  <div><span>Address</span><%= debtor.address||'—' %></div><div><span>Employer</span><%= debtor.employer||'—' %></div>
  <% if (may('debtors.sensitive')) { %><div><span>Salary</span><%= debtor.salary!=null?debtor.salary:'—' %></div><% } %>
  <div><span>Risk</span><span class="badge <%= debtor.risk_level==='high'?'is-red':debtor.risk_level==='low'?'is-green':'is-gold' %>"><%= debtor.risk_level %></span></div>
  <% if (may('debtors.sensitive')) { %><div><span>Guarantor Name</span><%= debtor.guarantor_name||'—' %></div><div><span>Guarantor Phone</span><span class="mono"><%= debtor.guarantor_phone||'—' %></span></div><% } %>
  <div><span>Remark</span><%= debtor.remark||'—' %></div>
</div>
<h2>Cases</h2>
<% if (!cases.length) { %><%- include('../partials/empty', { msg: 'No cases for this debtor.' }) %><% } else { %>
<table class="data"><thead><tr><th>Case No</th><th class="num">Settlement Today</th><th>Status</th></tr></thead><tbody>
<% cases.forEach(c => { %><tr><td><a href="/cases/<%= c.id %>" class="mono"><%= c.case_no %></a></td>
<td class="num"><%= h.money(c.settlement) %></td><td><%- include('../partials/statusBadge', { status: c.status }) %></td></tr><% }) %>
</tbody></table><% } %>
