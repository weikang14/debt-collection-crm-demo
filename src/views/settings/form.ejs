<% layout('layout') -%>
<div class="page-head"><h1>Company Settings</h1></div>
<p class="hint">This company info appears on the printed case statement header.</p>
<form class="card form" method="post" action="/settings" enctype="multipart/form-data">
  <label>Company Name <input name="company_name" value="<%= s.company_name || '' %>"></label>
  <label>Address <textarea name="address" rows="2"><%= s.address || '' %></textarea></label>
  <label>Phone <input name="phone" value="<%= s.phone || '' %>"></label>
  <label>Email <input name="email" type="email" value="<%= s.email || '' %>"></label>
  <label>Registration No <input name="reg_no" value="<%= s.reg_no || '' %>"></label>
  <label>Moneylending Licence No (KPKT) <input name="licence_no" value="<%= s.licence_no || '' %>" maxlength="60"></label>
  <label>Max annual interest rate (% p.a.) <span class="hint">(at most 18%, the legal limit for unsecured loans; you can only set it lower — new cases and restructures above it are refused)</span>
    <input name="max_annual_rate" type="number" step="0.01" min="0.01" max="18" value="<%= s.max_annual_rate ?? 18 %>" required>
  </label>
  <% if (overCap.length) { %>
  <div class="alert is-red">Open loans above the <%= cap %>% p.a. cap:
    <% overCap.forEach((o, i) => { %><%= i ? ', ' : '' %><a href="/cases/<%= o.id %>"><%= o.case_no %></a> (<%= Number(o.rate.toFixed(4)) %>%)<% }) %> — re-plan them with a restructure.</div>
  <% } %>
  <label>Data retention (years) <span class="hint">(personal data of a debtor whose cases are all Fully Paid, Closed or Cancelled is removed this many years after the last activity; at least 6, the limitation period)</span>
    <input name="retention_years" type="number" step="1" min="6" max="99" value="<%= s.retention_years ?? 7 %>" required>
  </label>
  <label>Logo <span class="hint">(PNG/JPEG/SVG/WebP, max 512KB)</span>
    <input name="logo" type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp">
  </label>
  <% if (s.logo) { %>
    <div>
      <img src="<%= s.logo %>" alt="Current logo" style="max-height:64px;display:block;margin:6px 0">
      <label class="inline"><input type="checkbox" name="remove_logo" value="1"> Remove current logo</label>
    </div>
  <% } %>
  <div class="form-actions"><button class="btn btn-gold" type="submit">Save</button><a class="btn" href="/">Cancel</a></div>
</form>
<form class="card form" method="post" action="/settings/anonymize" style="margin-top:14px">
  <h3 style="margin:0">Data retention</h3>
  <% if (!due.list.length) { %>
  <p class="hint">No debtor is past the <%= due.years %>-year retention period (nothing on file since before <%= due.cutoff %>).</p>
  <% } else { %>
  <p><%= due.list.length %> debtor(s) past the <%= due.years %>-year retention period (all cases finished, last activity before <%= due.cutoff %>):
    <% due.list.forEach((d, i) => { %><%= i ? ', ' : '' %><a href="/debtors/<%= d.id %>"><%= d.name %></a> (<%= d.last %>)<% }) %></p>
  <p class="hint">Removing clears the name, IC, contact details, employer, salary, guarantor, remarks, call notes and numbers, and note / call / task text. Amounts, dates and receipt numbers stay. It cannot be undone.</p>
  <label class="inline"><input type="checkbox" name="confirm" value="1"> I confirm the removal</label>
  <div class="form-actions"><button class="btn" type="submit">Remove personal data</button></div>
  <% } %>
</form>
