<% layout('layout'); -%>
<div class="page-head">
  <h1><%= c.case_no %> <%- include('../partials/statusBadge', { status: c.status }) %></h1>
  <div class="head-actions">
    <% if (!readOnly) { %>
      <% if (['admin','manager','finance','agent'].includes(currentUser.role)) { %><button type="button" class="btn btn-gold" onclick="dlg('dlg-payment')">Record Payment</button><% } %>
      <% if (restructureForm && ['admin','manager'].includes(currentUser.role)) { %><button type="button" class="btn" onclick="dlg('dlg-restructure')">Restructure</button><% } %>
      <% if (['admin','manager','agent'].includes(currentUser.role)) { %>
        <button type="button" class="btn" onclick="dlg('dlg-ptp')">New PTP</button>
        <button type="button" class="btn" onclick="dlg('dlg-plan')">New Plan</button>
        <button type="button" class="btn" onclick="dlg('dlg-call')">Log Call</button>
      <% } %>
    <% } %>
    <a class="btn" href="/cases/<%= c.id %>/statement" target="_blank">Print statement</a>
    <% if (['admin','manager'].includes(currentUser.role)) { %><a class="btn" href="/cases/<%= c.id %>/edit">Edit Case</a><% } %>
    <button type="button" class="btn icon-btn" title="Records" aria-label="Records" onclick="dlg('dlg-records')">&#9776;</button>
  </div>
</div>

<%
  const paid = payments.reduce((s, p) => s + p.amount, 0);
  const total = (c.principal_amount || 0) + (c.interest_charged || 0);
  const recovered = total > 0 ? Math.round(paid / total * 100) : 0;
  const daysOpen = Math.max(0, Math.floor((Date.now() - new Date(c.opened_at).getTime()) / 86400000));
  const nextTask = tasks
    .filter(t => t.status === 'pending' && t.due_date)
    .sort((a, b) => a.due_date < b.due_date ? -1 : (a.due_date > b.due_date ? 1 : 0))[0];
%>
<section class="ledger">
  <div class="ledger-lead">
    <div class="ledger-lbl">Total Outstanding</div>
    <div class="ledger-amt"><span class="ledger-cur">RM</span><%= h.money(c.outstanding_amount) %></div>
    <div class="ledger-bar"><i style="width:<%= Math.min(recovered, 100) %>%"></i></div>
    <div class="ledger-meta"><b><%= recovered %>% recovered</b><span>RM <%= h.money(paid) %> of <%= h.money(total) %> paid · opened <%= daysOpen %> <%= daysOpen === 1 ? 'day' : 'days' %> ago</span></div>
  </div>
  <div class="ledger-vr"></div>
  <div class="ledger-break">
    <div><div class="ledger-lbl">Principal</div><div class="ledger-val"><%= h.money(c.principal_amount) %></div></div>
    <div><div class="ledger-lbl">Interest</div><div class="ledger-val"><%= h.money(c.interest_charged) %></div></div>
    <div><div class="ledger-lbl">Paid</div><div class="ledger-val pos"><%= h.money(paid) %></div></div>
    <% const maturity = lastRestructure ? lastRestructure.maturity_date : c.maturity_date; %>
    <% if (maturity) { %>
    <div><div class="ledger-lbl">Maturity Date</div><div class="ledger-val"><%= h.dateFmt(maturity) %></div>
      <% if (lastRestructure) { %><small style="color:var(--muted)">Restructured on <%= h.dateFmt(lastRestructure.effective_date) %></small><% } %></div>
    <% } %>
  </div>
</section>

<div class="case-main">
    <div class="card kv">
      <% if (!readOnly && ['admin','manager','agent'].includes(currentUser.role)) { %>
      <div class="kv-head">
        <form method="post" action="/cases/<%= c.id %>/status" class="status-inline">
          <label>Status
            <select name="status" onchange="this.form.submit()">
              <% statuses.forEach(s => { %><option value="<%= s %>" <%= c.status===s?'selected':'' %>><%= h.caseStatusLabel(s) %></option><% }) %>
            </select>
          </label>
        </form>
      </div>
      <% } %>
      <div><span>Debtor</span><a href="/debtors/<%= c.debtor_id %>"><%= c.debtor_name %></a></div>
      <div><span>Debtor Phone</span><span class="mono"><%= c.debtor_phone||'—' %></span></div>
      <div><span>IC/Passport</span><span class="mono"><%= c.ic_passport||'—' %></span></div>
      <div><span>Agent</span><%= c.agent_name||'—' %></div>
      <div><span>Priority</span><span class="badge <%= c.priority==='urgent'||c.priority==='high'?'is-red':c.priority==='low'?'is-neutral':'is-gold' %>"><%= c.priority %></span></div>
      <div><span>Opened</span><%= h.dateFmt(c.opened_at) %></div>
      <% if (c.interest_mode === 'monthly' || c.interest_mode === 'daily') { %>
      <div><span>Loan Start Date</span><%= h.dateFmt(c.loan_start_date || c.opened_at) %>
        <small style="color:var(--muted)">· interest accrues from this date<% if (!c.loan_start_date) { %> (unset, defaults to opened)<% } %></small></div>
      <% } %>
      <div><span>Next Action</span><%= nextTask ? (h.dateFmt(nextTask.due_date) + ' · ' + nextTask.title) : '—' %></div>
      <div><span>Remark</span><%= c.remark||'—' %></div>
    </div>

    <% if (!readOnly && ['admin','manager','agent'].includes(currentUser.role)) { %>
    <form class="add-note" method="post" action="/cases/<%= c.id %>/notes">
      <input name="content" placeholder="Add a note…" required>
      <button class="btn btn-gold" type="submit">Add</button>
    </form>
    <% } %>

    <h2>Timeline</h2>
    <% if (!timeline.length) { %><%- include('../partials/empty', { msg: 'No activity yet.' }) %><% } else { %>
    <% const evClass = { payment:'is-green', ptp_fulfilled:'is-green', ptp_broken:'is-red', ptp_created:'is-gold', status_change:'is-blue', legal:'is-red', call:'is-blue', restructure:'is-gold' }; %>
    <ul class="timeline">
    <% const canEditNote = !readOnly && ['admin','manager','agent'].includes(currentUser.role); %>
    <% timeline.forEach(ev => { %><li><span class="badge <%= evClass[ev.event_type]||'is-neutral' %>"><%= ev.event_type %></span>
      <% if (ev.event_type==='note' && canEditNote) { %>
        <%= ev.content %>
        <span class="note-actions">
          <button type="button" class="btn btn-sm" onclick="editNote(this)" data-id="<%= ev.id %>" data-content="<%= ev.content %>">Edit</button>
          <form method="post" action="/cases/<%= c.id %>/notes/<%= ev.id %>/delete" onsubmit="return confirm('Delete this note?')"><button class="btn btn-sm" type="submit">Delete</button></form>
        </span>
      <% } else { %><%= ev.content %><% } %>
      <span class="meta"><%= ev.created_by||'system' %> · <%= h.dateTimeFmt(ev.created_at) %></span></li><% }) %>
    </ul>
    <% } %>
</div>

<dialog id="dlg-records" class="modal modal-wide">
  <div class="modal-head">
    <h3>Records</h3>
    <button type="button" class="btn icon-btn" onclick="this.closest('dialog').close()" aria-label="Close">&times;</button>
  </div>
  <div class="modal-body">
    <% if (schedule.length) { %>
    <section class="rec-section">
    <h2>Repayment Schedule<% if (lastRestructure) { %> <small style="color:var(--muted)">· since restructure on <%= h.dateFmt(lastRestructure.effective_date) %></small><% } %></h2>
    <%
      // Payments fill periods oldest-first (FIFO in schedule.js), so only the
      // earliest unpaid period gets a Pay button — paying a later row would
      // still land on the earlier ones. The prefill is capped at the ledger
      // outstanding: per-period cent rounding can leave the schedule a few cents
      // above it, and the payment validator rejects any overpay.
      const canPay = !readOnly && ['admin','manager','finance','agent'].includes(currentUser.role);
      const nextDue = schedule.findIndex(r => r.outstanding_amount > 0);
    %>
    <%- include('../partials/scheduleTable', { rows: schedule, pay: canPay ? { nextDue, cap: c.outstanding_amount } : null }) %>
    </section>
    <% } %>

    <% if (scheduleHistory.length) { %>
    <section class="rec-section">
    <h2>Restructure History</h2>
    <% const canManageRs = !readOnly && ['admin','manager'].includes(currentUser.role); %>
    <% scheduleHistory.slice().reverse().forEach(({ restructure: r, rows }) => { %>
      <div class="card" style="margin-bottom:0.75rem;">
        <div><b><%= h.dateFmt(r.effective_date) %></b> · <%= h.interestTerms(r.interest_mode, r.interest_rate, r.interest_amount) %> · <%= r.tenure %> months · by <%= r.created_by || '—' %></div>
        <div>Principal at cut RM <%= h.money(r.principal_at_cut) %> · Arrears carried RM <%= h.money(r.arrears_at_cut) %></div>
        <div>Reason: <%= r.reason %></div>
        <% if (canManageRs && canUndo && r.id === lastRestructure.id) { %>
        <form method="post" action="/cases/<%= c.id %>/restructures/<%= r.id %>/undo" style="margin:0.5rem 0 0;" onsubmit="return confirm('Undo this restructure?')"><button class="btn btn-sm" type="submit">Undo</button></form>
        <% } %>
        <% if (rows.length) { %>
        <details style="margin-top:0.5rem;"><summary>Superseded schedule (<%= rows.length %> rows)</summary>
          <%- include('../partials/scheduleTable', { rows, pay: null }) %>
        </details>
        <% } %>
      </div>
    <% }) %>
    </section>
    <% } %>

    <section class="rec-section">
    <% const canEditPay = !readOnly && ['admin','manager','finance'].includes(currentUser.role); %>
    <h2>Payments</h2>
    <% if (!payments.length) { %><%- include('../partials/empty', { msg: 'No payments recorded.' }) %><% } else { %>
    <table class="data"><thead><tr><th>Receipt No</th><th>Date</th><th class="num">Amount</th><th>Method</th><% if (canEditPay) { %><th>Actions</th><% } %></tr></thead>
    <tbody><% payments.forEach(p => { %><tr><td class="mono"><%= p.receipt_no %></td><td><%= h.dateFmt(p.payment_date) %></td>
    <td class="num"><%= h.money(p.amount) %></td><td><%= p.method %></td>
    <% if (canEditPay) { %><td><% if (lock && p.payment_date < lock) { %><small style="color:var(--muted)">Locked · restructured</small><% } else { %><div style="display:flex; gap:0.5rem;">
      <button type="button" class="btn btn-sm" onclick="openEditPayment(<%= p.id %>, <%= p.amount %>, '<%= String(p.payment_date).slice(0, 10) %>', '<%= p.method %>', '<%= p.reference||'' %>', '<%= p.bank||'' %>')">Edit</button>
      <form method="post" action="/cases/<%= c.id %>/payments/<%= p.id %>/void" style="margin:0;" onsubmit="return confirm('Void payment <%= p.receipt_no %>?')"><button class="btn btn-sm" type="submit">Void</button></form>
    </div><% } %></td><% } %></tr><% }) %></tbody></table>
    <% } %>
    </section>

    <section class="rec-section">
    <h2>Promise to Pay</h2>
    <% if (!ptps.length) { %><%- include('../partials/empty', { msg: 'No PTPs recorded.' }) %><% } else { %>
    <%
      // Group by plan_id for headers/progress. Nulls (standalone PTPs) stay ungrouped.
      const planGroups = {};
      ptps.forEach(p => { if (p.plan_id) { (planGroups[p.plan_id] ||= []).push(p); } });
      const canManagePtp = !readOnly && ['admin','manager','agent'].includes(currentUser.role);
      let lastPlan = undefined;
    %>
    <table class="data"><thead><tr><th>Installment</th><th class="num">Amount</th><th>Due Date</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody><% ptps.forEach(p => { %>
      <% if (p.plan_id && p.plan_id !== lastPlan) { lastPlan = p.plan_id;
           const g = planGroups[p.plan_id];
           const paid = g.filter(x => x.status==='fulfilled').length;
           const total = g.reduce((s,x)=>s+x.amount,0);
           const hasPending = g.some(x => x.status==='pending'); %>
      <tr class="plan-head"><td colspan="4"><b>Installment Plan</b> · RM <%= h.money(total) %> · <%= paid %>/<%= g[0].plan_size %> paid</td>
        <td><% if (hasPending && canManagePtp) { %>
          <form method="post" action="/cases/<%= c.id %>/ptp-plans/<%= p.plan_id %>/cancel" style="margin:0;" onsubmit="return confirm('Cancel this installment plan? All pending installments will be broken.')"><button class="btn btn-sm" type="submit">Cancel plan</button></form>
        <% } %></td></tr>
      <% } %>
      <tr><td><%= p.plan_id ? (p.installment_no + '/' + p.plan_size) : '—' %></td>
      <td class="num"><%= h.money(p.amount) %></td><td><%= h.dateFmt(p.due_date) %></td>
      <td><span class="badge <%= p.status==='fulfilled'?'is-green':p.status==='broken'?'is-red':'is-gold' %>"><%= p.status %></span></td>
      <td><% if (p.status==='pending' && canManagePtp) { %>
      <div style="display:flex; gap:0.5rem;">
        <button type="button" class="btn btn-sm" onclick="openFulfill(<%= p.id %>, <%= p.amount %>)">Fulfill</button>
        <form method="post" action="/ptps/<%= p.id %>/break" style="margin:0;"><button class="btn btn-sm" type="submit">Break</button></form>
      </div>
      <% } else { %>—<% } %></td></tr>
    <% }) %></tbody></table>
    <% } %>
    </section>

    <section class="rec-section">
    <h2>Calls</h2>
    <% if (!calls.length) { %><%- include('../partials/empty', { msg: 'No calls logged.' }) %><% } else { %>
    <table class="data"><thead><tr><th>Time</th><th>Duration</th><th>Result</th><th>Notes</th></tr></thead>
    <tbody><% calls.forEach(call => { %><tr><td><%= h.dateTimeFmt(call.call_time) %></td><td><%= call.duration_seconds %>s</td>
    <td><span class="badge <%= call.result==='answered'?'is-green':'is-neutral' %>"><%= call.result %></span></td><td><%= call.notes||'' %></td></tr><% }) %></tbody></table>
    <% } %>
    </section>

    <section class="rec-section">
    <h2>Tasks</h2>
    <% if (!tasks.length) { %><%- include('../partials/empty', { msg: 'No tasks for this case.' }) %><% } else { %>
    <table class="data"><thead><tr><th>Title</th><th>Due Date</th><th>Status</th></tr></thead>
    <tbody><% tasks.forEach(t => { %><tr><td><%= t.title %></td><td><%= h.dateFmt(t.due_date) %></td>
    <td><span class="badge <%= t.status==='done'?'is-green':'is-gold' %>"><%= t.status %></span></td></tr><% }) %></tbody></table>
    <% } %>
    </section>
  </div>
</dialog>

<% if (!readOnly) { %>
<% if (restructureForm && ['admin','manager'].includes(currentUser.role)) { %>
<dialog id="dlg-restructure" class="modal"><form class="form" method="post" action="/cases/<%= c.id %>/restructures">
  <h3>Restructure Loan</h3>
  <p style="margin:0 0 0.5rem;color:var(--muted);font-size:13px;">Remaining principal RM <%= h.money(restructureForm.cut.principal) %> · unpaid interest RM <%= h.money(restructureForm.cut.arrears) %> as of today. Unpaid interest is carried as arrears (recalculated for the effective date you pick) and does not earn further interest.</p>
  <% if (restructureForm.range.min > restructureForm.range.max) { %>
  <div class="alert is-red">No valid effective date today — it must be on or after <%= restructureForm.range.min %>.</div>
  <% } %>
  <label>Effective Date <input type="date" name="effective_date" min="<%= restructureForm.range.min %>" max="<%= restructureForm.range.max %>" value="<%= restructureForm.range.max %>" required></label>
  <label>Interest Mode <select name="interest_mode" id="rs-mode">
    <option value="monthly">Monthly rate %</option><option value="daily">Annual rate % (÷365 daily)</option><option value="fixed">Fixed amount</option>
  </select></label>
  <label class="rs-accrual">Interest Rate % <input type="number" step="0.01" min="0" name="interest_rate"></label>
  <label class="rs-fixed">Interest Amount (RM) <input type="number" step="0.01" min="0" name="interest_amount"></label>
  <label>Tenure (months) <input type="number" step="1" min="1" max="120" name="tenure" required></label>
  <label>Reason <textarea name="reason" required></textarea></label>
  <div class="form-actions"><button class="btn btn-gold" type="submit">Restructure</button><button class="btn" type="button" onclick="this.closest('dialog').close()">Cancel</button></div>
</form></dialog>
<% } %>
<% if (['admin','manager','finance','agent'].includes(currentUser.role)) { %>
<dialog id="dlg-payment" class="modal"><form class="form" method="post" action="/cases/<%= c.id %>/payments">
  <h3>Record Payment</h3>
  <label>Date <input type="date" name="payment_date" required<% if (lock) { %> min="<%= lock %>"<% } %>></label>
  <label>Amount (RM) <small style="color:var(--muted)">· max <%= h.money(c.outstanding_amount) %></small> <input type="number" step="0.01" min="0.01" max="<%= c.outstanding_amount %>" name="amount" id="pay-amount" required></label>
  <label>Method <select name="method"><option>bank_transfer</option><option>cash</option><option>cheque</option><option>online</option></select></label>
  <label>Reference <input name="reference"></label>
  <label>Bank <input name="bank"></label>
  <div class="form-actions"><button class="btn btn-gold" type="submit">Add Payment</button><button class="btn" type="button" onclick="this.closest('dialog').close()">Cancel</button></div>
</form></dialog>
<% } %>
<% if (['admin','manager','finance'].includes(currentUser.role)) { %>
<dialog id="dlg-payment-edit" class="modal"><form class="form" id="payment-edit-form" method="post" action="">
  <h3>Edit Payment</h3>
  <label>Date <input type="date" name="payment_date" id="pe-date" required<% if (lock) { %> min="<%= lock %>"<% } %>></label>
  <label>Amount (RM) <input type="number" step="0.01" min="0.01" name="amount" id="pe-amount" required></label>
  <label>Method <select name="method" id="pe-method"><option>bank_transfer</option><option>cash</option><option>cheque</option><option>online</option></select></label>
  <label>Reference <input name="reference" id="pe-ref"></label>
  <label>Bank <input name="bank" id="pe-bank"></label>
  <div class="form-actions"><button class="btn btn-gold" type="submit">Save</button><button class="btn" type="button" onclick="this.closest('dialog').close()">Cancel</button></div>
</form></dialog>
<% } %>
<% if (['admin','manager','agent'].includes(currentUser.role)) { %>
<dialog id="dlg-ptp" class="modal"><form class="form" method="post" action="/cases/<%= c.id %>/ptps">
  <h3>New PTP</h3>
  <label>Amount (RM) <small style="color:var(--muted)">· max <%= h.money(c.outstanding_amount) %></small> <input type="number" step="0.01" min="0.01" max="<%= c.outstanding_amount %>" name="amount" required></label>
  <label>Due Date <input type="date" name="due_date" required></label>
  <label>Remark <input name="remark"></label>
  <div class="form-actions"><button class="btn btn-gold" type="submit">Add PTP</button><button class="btn" type="button" onclick="this.closest('dialog').close()">Cancel</button></div>
</form></dialog>
<dialog id="dlg-plan" class="modal"><form class="form" method="post" action="/cases/<%= c.id %>/ptp-plans">
  <h3>New Installment Plan</h3>
  <label>Total Amount (RM) <small style="color:var(--muted)">· max <%= h.money(c.outstanding_amount) %></small> <input type="number" step="0.01" min="0.01" max="<%= c.outstanding_amount %>" name="total_amount" required></label>
  <label>Number of Installments <input type="number" min="2" max="60" step="1" name="num_installments" value="3" required></label>
  <label>First Due Date <input type="date" name="first_due_date" required></label>
  <div class="form-actions"><button class="btn btn-gold" type="submit">Create Plan</button><button class="btn" type="button" onclick="this.closest('dialog').close()">Cancel</button></div>
</form></dialog>
<dialog id="dlg-call" class="modal"><form class="form" method="post" action="/cases/<%= c.id %>/calls">
  <h3>Log Call</h3>
  <label>Result <select name="result"><option>answered</option><option>no_answer</option><option>busy</option><option>wrong_number</option><option>refused</option></select></label>
  <label>Duration (s) <input type="number" name="duration_seconds" min="0" value="0"></label>
  <label>Notes <input name="notes"></label>
  <div class="form-actions"><button class="btn btn-gold" type="submit">Log Call</button><button class="btn" type="button" onclick="this.closest('dialog').close()">Cancel</button></div>
</form></dialog>
<dialog id="dlg-ptp-fulfill" class="modal"><form class="form" id="fulfill-form" method="post" action="">
  <h3>Fulfill PTP — Record Payment</h3>
  <label>Amount (RM) <small style="color:var(--muted)">· max <%= h.money(c.outstanding_amount) %></small> <input type="number" step="0.01" min="0.01" max="<%= c.outstanding_amount %>" name="amount" id="fulfill-amount" required></label>
  <label>Date <input type="date" name="payment_date" required<% if (lock) { %> min="<%= lock %>"<% } %>></label>
  <label>Method <select name="method"><option>bank_transfer</option><option>cash</option><option>cheque</option><option>online</option></select></label>
  <div class="form-actions"><button class="btn btn-gold" type="submit">Confirm &amp; Record</button><button class="btn" type="button" onclick="this.closest('dialog').close()">Cancel</button></div>
</form></dialog>
<dialog id="dlg-note-edit" class="modal"><form class="form" id="note-edit-form" method="post" action="">
  <h3>Edit Note</h3>
  <label>Note <textarea name="content" id="ne-content" required></textarea></label>
  <div class="form-actions"><button class="btn btn-gold" type="submit">Save</button><button class="btn" type="button" onclick="this.closest('dialog').close()">Cancel</button></div>
</form></dialog>
<% } %>
<% } %>
<script>
  function dlg(id){ document.getElementById(id).showModal(); }
  function editNote(btn){
    var f = document.getElementById('note-edit-form');
    f.action = '/cases/<%= c.id %>/notes/' + btn.dataset.id;
    document.getElementById('ne-content').value = btn.dataset.content;
    dlg('dlg-note-edit');
  }
  function openFulfill(id, amount){
    var f = document.getElementById('fulfill-form');
    f.action = '/ptps/' + id + '/fulfill';
    document.getElementById('fulfill-amount').value = amount;
    dlg('dlg-ptp-fulfill');
  }
  function payInstallment(amount){
    document.getElementById('pay-amount').value = amount;
    dlg('dlg-payment');
  }
  function openEditPayment(id, amount, date, method, ref, bank){
    var f = document.getElementById('payment-edit-form');
    f.action = '/cases/<%= c.id %>/payments/' + id;
    document.getElementById('pe-amount').value = amount;
    // Same ceiling as the server: outstanding as if this payment didn't exist.
    document.getElementById('pe-amount').max = Math.round((<%= c.outstanding_amount %> + amount) * 100) / 100;
    document.getElementById('pe-date').value = date;
    document.getElementById('pe-method').value = method;
    document.getElementById('pe-ref').value = ref;
    document.getElementById('pe-bank').value = bank;
    dlg('dlg-payment-edit');
  }
  (function(){
    var s = document.getElementById('rs-mode'); if (!s) return;
    // Only the visible field is required, so a blank rate can't slip through as 0%.
    function sync(){ var fixed = s.value === 'fixed';
      document.querySelectorAll('.rs-accrual').forEach(function(e){ e.style.display = fixed ? 'none' : ''; e.querySelector('input').required = !fixed; });
      document.querySelectorAll('.rs-fixed').forEach(function(e){ e.style.display = fixed ? '' : 'none'; e.querySelector('input').required = fixed; }); }
    s.addEventListener('change', sync); sync();
  })();
  document.querySelectorAll('dialog.modal').forEach(function(d){
    d.addEventListener('click', function(e){ if (e.target === d) d.close(); });
  });
  (function(){
    var today = new Date(Date.now() + 8*3600*1000).toISOString().slice(0,10);
    document.querySelectorAll('dialog.modal input[type=date]').forEach(function(i){ if(!i.value) i.value = today; });
  })();
</script>
