<!doctype html><html><head><meta charset="utf-8"><title>Demo Accounts — Debt Collection CRM</title>
<link rel="stylesheet" href="/css/style.css"></head>
<body class="login-page">
  <div class="login-card" style="width: 480px;">
    <h1 class="brand">Demo <span>Accounts</span></h1>
    <table class="data">
      <thead><tr><th>Username</th><th>Password</th><th>Access</th></tr></thead>
      <tbody>
        <% accounts.forEach(([username, password, access]) => { %>
        <tr>
          <td class="mono"><%= username %></td>
          <td class="mono"><%= password %></td>
          <td><%= access %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="hint"><a href="/login">← Back to login</a></p>
  </div>
</body></html>
